    "@zxing/library": "0.23.0",
    "antd": "5.29.3",
    "dayjs": "1.11.18",
    "echarts": "5.6.0",
    "echarts-for-react": "3.0.2",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",

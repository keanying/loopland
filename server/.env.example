# 圈圈 Loopland 后端环境变量模板
#
# 不要把真实值提交到仓库。正式环境请放到阿里云 KMS / Kubernetes Secret，
# 以环境变量或文件形式注入：任何带「（可用 _FILE）」标记的变量都可以改成
# 同名加 _FILE 后缀，值为文件路径（适合 PEM 私钥），例如
#   WECHAT_MCH_PRIVATE_KEY_FILE=/etc/loopland/wechat/apiclient_key.pem
#
# LOOPLAND_ENV=prod 时，启动前会检查：下列功能缺任何一项配置都拒绝启动，
# 并列出缺了什么。暂不上线的功能写进 LOOPLAND_DISABLE。
# 配好后运行 `loopland-doctor` 逐项验证密钥是否可用。

# ---------------------------------------------------------------- 基础
LOOPLAND_ENV=prod                       # dev | prod
LOOPLAND_HTTP_ADDR=:8080
LOOPLAND_DATABASE_URL=postgres://loopland:***@pgm-xxx.pg.rds.aliyuncs.com:5432/loopland?sslmode=require
LOOPLAND_REDIS_URL=rediss://:***@r-xxx.redis.rds.aliyuncs.com:6379/0
LOOPLAND_PUBLIC_BASE_URL=https://api.example.com   # 支付回调地址的前缀，必须是公网 https
LOOPLAND_JWT_SECRET=                    # ≥32 字符随机串：openssl rand -base64 48
LOOPLAND_ADMIN_JWT_SECRET=              # ≥32 字符，与上面不同
LOOPLAND_DATA_KEY=                      # 手机号加密密钥，32 字节 base64：openssl rand -base64 32（丢失后已加密手机号无法解密）
LOOPLAND_BOOTSTRAP_ADMIN=               # 首次部署创建管理员 用户名:密码，建好后删掉
LOOPLAND_ACCESS_TTL=2h
LOOPLAND_REFRESH_TTL=720h
LOOPLAND_JOBS_OFF=                      # 设为 1 关闭本实例的后台任务（多实例时可只留一台跑）

# 暂不上线的功能，逗号分隔：
# sms, captcha, oneclick, realname, wechat_login, apple_login, wechat_pay, alipay, apple_iap
LOOPLAND_DISABLE=

# ---------------------------------------------------------------- 阿里云
# 一个 RAM 子账号，授予：AliyunDysmsFullAccess（短信）、AliyunDypnsFullAccess
# （号码认证）、AliyunYundunAFSFullAccess 或验证码 2.0 权限、AliyunCloudAuthFullAccess（实人认证）。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=               # （可用 _FILE）
ALIYUN_SMS_SIGN_NAME=圈圈                # 短信签名（需审核通过）
ALIYUN_SMS_TEMPLATE_CODE=SMS_000000000   # 验证码模板，变量名必须是 ${code}
ALIYUN_CAPTCHA_SCENE_ID=                # 验证码 2.0 场景 ID（App 端同一个场景）

# ---------------------------------------------------------------- 微信
# 微信开放平台「移动应用」：App 登录 + 微信支付共用同一个 AppID
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=                      # （可用 _FILE）
# 微信支付商户平台（APIv3，公钥模式）
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=                   # 商户 API 证书序列号
WECHAT_MCH_PRIVATE_KEY=                 # apiclient_key.pem 内容（可用 _FILE）
WECHAT_APIV3_KEY=                       # 32 位 APIv3 密钥（可用 _FILE）
WECHAT_PAY_PUBLIC_KEY=                  # 微信支付公钥 pub_key.pem（可用 _FILE）
WECHAT_PAY_PUBLIC_KEY_ID=               # PUB_KEY_ID_xxxx

# ---------------------------------------------------------------- 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=                     # 应用私钥（RSA2，PKCS1 或 PKCS8 均可）（可用 _FILE）
ALIPAY_PUBLIC_KEY=                      # 支付宝公钥，不是应用公钥（可用 _FILE）
ALIPAY_SANDBOX=                         # 1 = 沙箱环境

# ---------------------------------------------------------------- Apple
APPLE_BUNDLE_ID=com.loopland.app        # Sign in with Apple 的 audience，也用于校验内购交易
# App Store Server API（可选，V1 未使用；查询交易历史、退款时用）
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=                  # （可用 _FILE）
APPLE_IAP_SANDBOX=

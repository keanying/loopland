<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- 定位：运动轨迹与圈地。锁屏 / 后台继续记录走前台服务 + 常驻通知 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 高德 SDK 需要 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <!-- 阿里云号码认证：切换到蜂窝网络取号 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- 合规：ali_auth 插件声明了以下权限，一键登录并不需要，移除 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- AI 跟练（前置摄像头 + 端上姿态识别）和场馆签到扫码（mobile_scanner，后置摄像头 + 端上条码识别），
         画面只在本机处理，不上传、不保存。没有摄像头的设备也能安装（跟练只计时 + 手动计数，签到用定位） -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <!-- camera_android_camerax 声明了 camera.any（默认必需），改为可选 -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required"/>
    <!-- 合规：camera 插件声明了录音权限，AI 跟练不录音（enableAudio: false），移除 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <!-- release 只允许 HTTPS（ali_auth 插件默认打开了明文流量，这里覆盖）；
         debug 包在 src/debug/AndroidManifest.xml 里放开，方便连局域网开发后端 -->
    <application
        android:label="圈圈"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        tools:replace="android:usesCleartextTraffic">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 场馆二维码 App Link：https://<links.universal_link_domain>/v/<内容>（go_router 路由 /v/:payload）。
                 域名来自生成的 loopland.properties（LOOPLAND_LINK_DOMAIN）；服务器需在
                 https://<域名>/.well-known/assetlinks.json 声明 com.loopland.app 的签名证书 SHA-256 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${LOOPLAND_LINK_DOMAIN}" android:pathPrefix="/v/"/>
            </intent-filter>
        </activity>
        <!-- 高德 Key：config/app.yaml 的 amap.android_key → AMAP_ANDROID_KEY（dart-define 或生成的 android/loopland.properties，见 build.gradle.kts） -->
        <meta-data android:name="com.amap.api.v2.apikey" android:value="${AMAP_ANDROID_KEY}"/>
        <!-- 运动记录：geolocator 前台服务，类型 location（Android 14 起必须声明） -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            tools:replace="android:foregroundServiceType"/>
        <!-- 微信回调：fluwx 已在其 manifest 中以 activity-alias 声明
             <applicationId>.wxapi.WXEntryActivity / WXPayEntryActivity，无需重复声明 -->
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- 微信、支付宝、高德地图（fluwx / tobias / 导航） -->
        <package android:name="com.tencent.mm"/>
        <package android:name="hk.alipay.wallet"/>
        <package android:name="com.eg.android.AlipayGphone"/>
        <package android:name="com.autonavi.minimap"/>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>

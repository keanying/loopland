<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Link（微信 / 支付宝回调）。域名：config/app.yaml 的 links.universal_link_domain → Flutter/Loopland.xcconfig 的 LOOPLAND_ASSOCIATED_DOMAIN -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(LOOPLAND_ASSOCIATED_DOMAIN)</string>
	</array>
</dict>
</plist>
